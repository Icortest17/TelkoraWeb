{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "dub1"
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/:slug"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap-blog"
    },
    {
      "source": "/automatizacion-ia-zaragoza",
      "destination": "/api/zaragoza"
    },
    {
      "source": "/automatizacion-ia-yecla",
      "destination": "/api/yecla"
    },
    {
      "source": "/chatbots-whatsapp-ia",
      "destination": "/api/pagina?page=chatbots-whatsapp-ia"
    },
    {
      "source": "/automatizacion-crm-ia",
      "destination": "/api/pagina?page=automatizacion-crm-ia"
    },
    {
      "source": "/integraciones-n8n",
      "destination": "/api/pagina?page=integraciones-n8n"
    },
    {
      "source": "/presupuesto-automatizacion-ia",
      "destination": "/api/pagina?page=presupuesto-automatizacion-ia"
    },
    {
      "source": "/sobre-telkora",
      "destination": "/api/pagina?page=sobre-telkora"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}

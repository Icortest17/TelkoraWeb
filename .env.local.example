# Copia este archivo como .env.local para desarrollo local (nunca se sube a git)
# Estas mismas variables deben configurarse en Vercel → Project Settings → Environment Variables

SUPABASE_URL=https://zphvrkabhtcipdqitgrj.supabase.co
SUPABASE_ANON_KEY=

# Landing /subvencion-ia-murcia → api/lead-subvencion.js
# Entrega del lead (la primera configurada gana; si no hay ninguna, usa Formspree como la home):
# 1) Webhook de n8n que envía el correo a isaac.cortes@telkora.com
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_SECRET=
# 2) o Resend directo (dominio telkora.com verificado)
RESEND_API_KEY=
LEAD_FROM_EMAIL=Telkora Web <web@telkora.com>
# Destino (opcional, por defecto isaac.cortes@telkora.com)
LEAD_TO_EMAIL=
